[node name="4Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/4Card"]
