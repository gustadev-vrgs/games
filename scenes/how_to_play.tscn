text = "Como jogar"
horizontal_alignment = 1
[node name="Tabs" type="TabContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
[node name="Uno" type="Label" parent="Margin/VBox/Tabs"]
layout_mode = 2
text = "Combine cor, número ou símbolo. Curingas escolhem a cor. O +4 só pode ser usado sem carta da cor ativa. Após comprar, jogue apenas a carta comprada ou passe. Declare Uno ao ficar com uma carta."
autowrap_mode = 2
[node name="Caxeta" type="Label" parent="Margin/VBox/Tabs"]
layout_mode = 2
text = "Compre do monte ou descarte e depois descarte uma carta. Forme trincas de naipes diferentes ou sequências do mesmo naipe. A vira define o curinga. Bata com nove cartas ao descartar, ou com dez se houver sequência de quatro ou mais."
autowrap_mode = 2
[node name="Truco Paulista" type="Label" parent="Margin/VBox/Tabs"]
layout_mode = 2
text = "Ganhe duas de três vazas. A carta após a vira define a manilha; entre manilhas, Paus, Copas, Espadas e Ouros. Peça Truco e aumente a mão para 3, 6, 9 ou 12 pontos. Em duplas, seu parceiro fica no assento oposto."
autowrap_mode = 2
[node name="Rede LAN" type="Label" parent="Margin/VBox/Tabs"]
layout_mode = 2
text = "O host cria a sala e também joga. Os demais usam o IPv4 LAN e a mesma porta UDP. Permita o jogo no Firewall, use a mesma build e confirme que todos estão na mesma rede sem isolamento de clientes."
autowrap_mode = 2
[node name="Back" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Voltar"
[node name="Status" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
