[node name="1Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/1Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/1Card/Text"]
