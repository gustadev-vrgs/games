[node name="1Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/1Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/1Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Preparação"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/1Card/Text"]
layout_mode = 2
text = "Cada jogador recebe cartas, uma vira define o curinga e o restante forma o monte de compra."
autowrap_mode = 2
[node name="2Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/2Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Caxeta/Cards/2Card/Text"]
