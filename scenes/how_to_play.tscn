[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/1Card/Text"]
layout_mode = 2
text = "Cada jogador recebe três cartas. A carta virada determina a manilha da mão."
autowrap_mode = 2
[node name="2Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/2Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/2Card/Text"]
