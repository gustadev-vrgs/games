[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/0Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Objetivo"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/0Card/Text"]
layout_mode = 2
text = "Seja o primeiro a ficar sem cartas. Combine a carta jogada com a cor, o número ou o símbolo do descarte."
autowrap_mode = 2
[node name="1Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards/1Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/1Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Preparação"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/1Card/Text"]
layout_mode = 2
text = "Cada jogador recebe sete cartas. A primeira carta do monte inicia o descarte e define a cor ativa."
autowrap_mode = 2
[node name="2Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards/2Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/2Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "O que fazer no turno"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/2Card/Text"]
layout_mode = 2
text = "Jogue uma carta compatível. Você pode selecionar e jogar várias cartas numéricas iguais na mesma jogada. A primeira precisa combinar com o descarte, e a última selecionada define a nova cor ativa."
autowrap_mode = 2
[node name="3Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards/3Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/3Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Ações especiais"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/3Card/Text"]
layout_mode = 2
text = "Bloqueio pula o próximo jogador; Inverter muda o sentido; +2 e +4 fazem o próximo comprar. Curingas permitem escolher a cor."
autowrap_mode = 2
[node name="4Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Uno/Cards/4Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/4Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Como vencer"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Uno/Cards/4Card/Text"]
layout_mode = 2
text = "Declare Uno ao ficar com uma carta. A rodada termina quando um jogador descarta sua última carta."
autowrap_mode = 2
