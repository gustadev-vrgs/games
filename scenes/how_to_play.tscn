theme_override_font_sizes/font_size = 20
text = "Antes de começar"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/0Card/Text"]
layout_mode = 2
text = "Todos precisam usar a mesma versão do jogo e permitir a conexão no firewall."
autowrap_mode = 2
[node name="1Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/1Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/1Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Passo a passo"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/1Card/Text"]
layout_mode = 2
text = "1. Conecte os computadores à mesma rede.
2. O host cria a sala.
3. O host informa IP e porta.
4. Os demais entram usando os mesmos dados.
5. Todos confirmam que estão prontos.
6. O host inicia a partida."
autowrap_mode = 2
[node name="2Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/2Card"]
layout_mode = 2
[node name="Heading" type="Label" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/2Card/Text"]
layout_mode = 2
theme_override_colors/font_color = Color(0.957, 0.788, 0.365, 1)
theme_override_font_sizes/font_size = 20
text = "Dica de conexão"
[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Rede LAN/Cards/2Card/Text"]
layout_mode = 2
text = "Use o IPv4 local do computador host e a mesma porta em todos os computadores. Redes com isolamento de clientes podem impedir a conexão."
autowrap_mode = 2
