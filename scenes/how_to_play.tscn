[node name="3Card" type="PanelContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards"]
layout_mode = 2
[node name="Text" type="VBoxContainer" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/3Card"]
