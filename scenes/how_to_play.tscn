[node name="Body" type="Label" parent="Margin/Panel/Layout/Tabs/Truco Paulista/Cards/2Card/Text"]
layout_mode = 2
text = "Jogue uma carta quando chegar sua vez. A carta mais forte vence a vaza; duas vazas vencem a mão."
